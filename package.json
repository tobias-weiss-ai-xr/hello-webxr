{
  "name": "hello-webxr",
  "version": "1.0.0",
  "description": "A showcase of different WebXR experiences and interaction examples",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc --noEmit && vite build --mode lib",
    "build:all": "npm run build && npm run build:lib",
    "preview": "vite preview",
    "test": "playwright test",
    "test:headed": "playwright test --headed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MozillaReality/hello-webxr.git"
  },
  "keywords": [
    "webxr",
    "webvr",
    "vr",
    "ecsy",
    "xr",
    "mozilla",
    "showcase",
    "museum"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MozillaReality/hello-webxr/issues"
  },
  "homepage": "https://github.com/MozillaReality/hello-webxr#readme",
  "dependencies": {
    "@babylonjs/core": "^9.2.0",
    "@babylonjs/gui": "^9.2.0",
    "@babylonjs/loaders": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.6.4",
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "babel-loader": "^8.0.6",
    "copy-webpack-plugin": "^6.4.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  },
  "main": "bundle.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  }
}
